  "cards": [
    {
      "dot": "cyan",
      "title": "数据导入",
      "items": [
        "自研 CSV 状态机解析器，正确处理引号内的逗号与换行、双引号转义",
        "类型推断把前导 0 编码与大整数保留为文本，避免精度丢失",
        "Excel 日期按 UTC 读取，避免东八区读出偏移一天的日期"
      ]
    },
    {
      "dot": "emerald",
      "title": "NL2SQL 链路",
      "items": [
        "表结构 + 真实样例行注入提示词，模型输出 SQL 与图表配置",
        "执行失败时把 SQLite 原始报错回传模型自我修正，最多重试 2 次",
        "图表字段与结果集对不上、结果仅 1 行时自动降级为表格"
      ]
    },
    {
      "dot": "rose",
      "title": "安全设计",
      "items": [
        "双层防护：SQL 白名单校验 + SQLite 只读连接执行",
        "校验前先剥离注释与字符串字面量，避免误报与注释绕过",
        "安全拦截立即终止、不给重试机会；执行失败才允许自愈"
      ]
    }
  ]
